{
  "manifest_version": 3,
  "name": "YouTube 雙語字幕（本機）",
  "version": "0.2.0",
  "description": "用自己的 GPU 在本機產生 YouTube 雙語字幕：原文與台灣正體中文同時顯示。",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "雙語字幕設定"
  },
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}
