{
  "manifest_version": 3,
  "name": "YouTube DualSub (local)",
  "version": "0.1.0",
  "description": "Bilingual YouTube subtitles generated on your own GPU: original speech plus Traditional Chinese, shown together.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube DualSub"
  },
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}
